(* Nippy grammar, as implemented.

   This is the accepted source language, not a wish list. When the parser
   changes, this file changes with it. Semantics are in SEMANTICS.md.

   Conventions:
     - ISO/IEC 14977 EBNF: "..." is a terminal, { } repeats zero or more times,
       [ ] is optional, ( ) groups, (* *) is a comment.
     - Whitespace (space, tab, newline) separates tokens and is otherwise
       insignificant. There is no preprocessor.
     - Offsets in diagnostics are byte offsets into the source; line and column
       are 1-based.
     - The shape follows the Lua/Luau family: keyword-delimited blocks ending in
       "end", no braces or semicolons, and type annotations written with ":".
*)

(* ---- program ---- *)

program            = item, { item }, end-of-input ;

item               = declaration
                   | assignment-statement
                   | expression-statement ;

declaration        = type-declaration
                   | value-declaration
                   | global-declaration
                   | function-declaration ;

(* ---- type declarations ---- *)

(* "type Name = T" is a transparent alias. "type Name Field* end" is a nominal
   struct. A type declaration may be generic; the parameter list follows the
   name in both forms. *)
type-declaration   = "type", identifier, [ type-parameters ],
                     ( "=", type
                     | field, { field }, "end" ) ;

type-parameters    = "<", identifier, { ",", identifier }, ">" ;

field              = identifier, ":", type ;

(* ---- values ---- *)

value-declaration  = "var", identifier, [ ":", type ], "=", expression ;

(* The same form is a statement inside a function or block. Store declarations
   remain program-level only. *)
local-declaration  = "var", identifier, [ ":", type ], "=", expression ;

(* The checker requires a global declaration's type to be Store. The legacy
   "var name: Store = Store(bytes)" spelling is still accepted. *)
global-declaration = "global", identifier, [ ":", type ], "=", expression ;

(* ---- functions ---- *)

function-declaration = "fun", identifier, [ type-parameters ],
                       "(", [ parameter-list ], ")", ":", type,
                       block, "end" ;

parameter-list     = parameter, { ",", parameter } ;

parameter          = identifier, ":", type ;

(* ---- statements ---- *)

block              = { statement } ;

statement          = return-statement
                   | if-statement
                   | while-statement
                   | match-statement
                   | for-statement
                   | break-statement
                   | continue-statement
                   | local-declaration
                   | assignment-statement
                   | expression-statement ;

(* Assignment is a statement, not an expression. The target is a variable,
   parameter, list index, or writable struct field. *)
assignment-statement = identifier, "=", expression
                     | identifier, "[", expression, "]", "=", expression
                     | identifier, ".", identifier,
                       { ".", identifier }, "=", expression ;

(* The checker accepts an expression statement only when the expression is a
   call; the value is discarded. *)
expression-statement = expression ;

return-statement   = "return", expression ;

if-statement       = "if", expression, "then", block,
                     { "elseif", expression, "then", block },
                     [ "else", block ], "end" ;

while-statement    = "while", expression, block, "end" ;

match-statement    = "match", [ "typeof" ], expression,
                     "with", pattern, "then", block,
                     { "with", pattern, "then", block },
                     [ "else", block ], "end" ;

for-statement      = "for", identifier, [ ",", identifier ],
                     "in", expression, "do", block, "end" ;

break-statement    = "break" ;

continue-statement = "continue" ;

(* ---- types ---- *)

type               = union-type ;

union-type         = primary-type, { "|", primary-type } ;

primary-type       = "String", "<", integer-literal, ">"
                   | "Array", "<", type, ",", integer-literal, ">"
                   | "List", "<", type, ">"
                   | "Slice", "<", type, ">"
                   | "Record", "<", type, ",", type, ",", integer-literal, ">"
                   | "Table", "<", type, ",", type, ">"
                   | type-name, [ "<", type-arguments, ">" ]
                   | function-type
                   | "(", type, ")" ;

type-name          = identifier ;
                     (* "Int32", "Bool", "Byte", "Nil", "Text",
                        "TextBuilder", "List", "Array", "Slice", "Store",
                        "Handle", "Error", a declared struct or alias, or a
                        type parameter in scope.
                        Bare "Text" is the dynamic arena/static-backed type.
                        List<T> is dynamic; Array<T,N> is fixed-capacity with a
                        runtime length. Slice<T> is a read-only view of a
                        dynamic list. String<N> is a fixed-capacity
                        inline string; N is a byte capacity in 0..4096 by
                        default (the configured maximum can raise or lower that
                        bound, up to 1 MiB). Store is only valid as the
                        annotation on a store declaration; Handle needs exactly
                        one type argument, whose type is fixed (no
                        allocator-backed fields). *)

(* ---- expressions ---- *)

(* Precedence, tightest first: is, unary, additive, relational, equality, &&,
   ||. *)
expression         = logical-or ;

logical-or         = logical-and, { "||", logical-and } ;

logical-and        = equality, { "&&", equality } ;

equality           = relational, { ( "==" | "!=" ), relational } ;

relational         = additive, { ( "<" | "<=" | ">" | ">=" ), additive } ;

additive           = unary, { "+", unary } ;

unary              = "!", unary
                   | postfix ;

(* Member operations are methods and fields. Type tests are `typeof x is T`. *)
postfix            = primary, { "[", expression, "]" | ".",
                                 ( member-operation | field-name ) } ;

field-name         = identifier ;

member-operation   = "is", "<", type, ">", "(", ")"
                   | identifier, [ "<", type, ">" ],
                     "(", [ expression, { ",", expression } ], ")" ;

primary            = typeof-test
                   | if-expression
                   | match-expression
                   | integer-literal
                   | string-literal
                   | list-literal
                   | record-literal
                   | boolean-literal
                   | nil-literal
                   | identifier
                   | call
                   | "(", expression, ")" ;

list-literal       = "[", [ expression, { ",", expression } ], "]" ;

record-literal     = "{", [ string-literal, ":", expression,
                            { ",", string-literal, ":", expression } ], "}" ;
                     (* Constructs a fixed Record; a Record annotation supplies
                        the key capacity and value type. Dynamic Tables use
                        arena.table<K,V>(capacity). *)
(* "Store", "Byte", "Handle", "Text", "String", "TextBuilder", "List",
   "Array", "Slice", "Record", "Table", and "Error" are ordinary identifiers;
   the checker gives them their built-in meaning. String literals are written
   with double quotes and are typed by context: a Text expected type gives a
   static dynamic string; a String<N> expected type gives a fixed inline value. *)

(* A call's name is resolved by the checker: a struct type makes it a
   constructor, a function or function-typed value makes it a function call.
   Generic struct constructors and generic function calls infer their type
   arguments; there is no explicit type-argument syntax in expressions.
   Named arguments are accepted only by struct constructors. Arguments are
   either all positional or all named; mixing them is a parse error. *)
call               = identifier, "(", [ argument-list ], ")" ;

typeof-test        = "typeof", expression, "is", type ;

if-expression      = "if", expression, "then", expression,
                     { "elseif", expression, "then", expression },
                     "else", expression, "end" ;

match-expression   = "match", [ "typeof" ], expression,
                     "with", pattern, "then", expression,
                     { "with", pattern, "then", expression },
                     "else", expression, "end" ;

pattern            = type | expression ;

argument-list      = argument, { ",", argument } ;

argument           = named-argument
                   | expression ;

named-argument     = identifier, "=", expression ;

(* ---- terminals ---- *)

integer-literal    = digit, { digit } ;
                     (* decimal only; must fit in a signed 32-bit int, so a
                        larger literal is a lexer error, not a wrap-around *)

string-literal     = '"', { string-character }, '"' ;
                     (* string-character is any source byte except a double
                        quote, a raw newline, a NUL byte, or a backslash. A
                        backslash starts one of: \n, \t, \r, \\, or \".
                        Any other escape is a lexer error. UTF-8 source bytes
                        pass through unchanged. The value is not NUL-terminated
                        in source; the fixed string representation adds the
                        terminator. *)

boolean-literal    = "true" | "false" ;

nil-literal        = "nil" ;

identifier         = letter-or-underscore, { letter-or-digit-or-underscore } ;
                     (* at most 31 characters. "var", "type", "fun", "return",
                        "if", "then", "elseif", "else", "while", "for", "in",
                        "do", "break", "continue", "true", "false", "nil", and
                        "end" are
                        keywords and are not identifiers. Longer names are a
                        lexer error *)

letter-or-underscore = "A" | ... | "Z" | "a" | ... | "z" | "_" ;
letter-or-digit-or-underscore = letter-or-underscore | digit ;
digit              = "0" | ... | "9" ;

(* ---- lexical structure ---- *)

(* Keywords *)
global             = "global" ;
var                = "var" ;
type               = "type" ;
fun                = "fun" ;
return             = "return" ;
if                 = "if" ;
then               = "then" ;
elseif             = "elseif" ;
else               = "else" ;
while              = "while" ;
for                = "for" ;
in                 = "in" ;
do                 = "do" ;
break              = "break" ;
continue           = "continue" ;
true               = "true" ;
false              = "false" ;
nil                = "nil" ;
end                = "end" ;

(* Punctuation and operators *)
":"                = ":" ;
"="                = "=" ;
"=="               = "==" ;
"!="               = "!=" ;
"("                = "(" ;
"["                = "[" ;
"]"                = "]" ;
")"                = ")" ;
","                = "," ;
"+"                = "+" ;
"<"                = "<" ;
"<="               = "<=" ;
">"                = ">" ;
">="               = ">=" ;
"&&"               = "&&" ;
"||"               = "||" ;
"|"                = "|" ;
"!"                = "!" ;
"."                = "." ;

(* end-of-input is the end of the source string. The driver rejects sources
   larger than 4096 bytes and sources containing a NUL byte before lexing. *)

(* ---- stores ---- *)

(* A store is a global declaration whose annotation is Store and whose
   initializer is Store(bytes):

       global points: Store = Store(4096)

   `bytes` is a constant Int32 expression (integer literals and +). Stores are
   global, non-first-class, and allocated at program start. The methods are:

       points.alloc<T>(value)   -> Handle<T>
       points.reset()           -> Nil
       points.concat(a, b)      -> Text
       points.copy(s)           -> Text
       points.text(f)         -> Text
       points.builder(capacity) -> TextBuilder
       points.list<T>(capacity)-> List<T>
       handle.read()            -> T
       handle.write(value)      -> Nil

   T must be a single item: Int32, Bool, Byte, Nil, a struct or concrete
   generic struct, a Handle<U>, a Text, a String<N>, a union, a function type,
   or Error. Collections (Array, List, Slice, TextBuilder) and Store are not
   allocation element types; use the collection allocator instead.

   Dynamic Text, fixed String<N>, and TextBuilder add value methods:

       s.byte_len()             -> Int32
       s.byte_at(i)             -> Byte (bounds-checked)
       s.slice(start, length)   -> Text (dynamic strings only)
       b.append(s)              -> Nil (dynamic Text argument)
       b.append_byte(byte)      -> Nil
       b.finish()               -> Text
       xs.len()                 -> Int32
       xs.push(value)           -> Nil (Array and List)
       r[key], r[key] = value   -> Record/Table entry; missing read panics
       for k, v in r            -> Record/Table keys and values
       for k in r               -> Record/Table keys
       r.has(key)               -> Bool
       r.remove(key)            -> Bool
       r.len()                  -> Int32
       xs.pop()                 -> T | Nil (Array and List)
       xs[i], xs[i] = value     -> list indexing (bounds-checked)
       xs.slice(start, length)  -> Slice<T> (dynamic lists only)
       s.len(), s[i]            -> read-only slice access
       e.header()               -> String<32>  (default capacity)
       e.description()          -> String<128> (default capacity)
       e.filename()             -> String<128> (default capacity)
       e.line(), e.col(), e.pos() -> Int32

   Text equality is content equality for the same Text or String<N> type.
   Text and String<N> do not convert implicitly; use points.text(fixed) for
   fixed-to-dynamic. TextBuilder copies alias the same builder state, and
   List<T> copies alias the same list state. A fixed Array literal may contain
   0..capacity elements. A dynamic list is created with
   points.list<T>(capacity). Error is constructed with Error(header, description,
   filename, line, col, pos). *)

(* ---- rejected forms worth naming ---- *)

(* A bare expression is not a program:
       13                      (* parser: expected 'global', 'var', 'type', or 'fun' ... *)
   A struct declaration needs at least one field:
       type Point end          (* parser: expected at least one field ... *)
   A generic type needs its arguments where it is named:
       type Box<T> value: T end
       var b: Box = Box(1)     (* checker: type 'Box' needs type arguments *)
   A store needs its Store(bytes) initializer:
       global s: Store = 16    (* checker: store 's' must be initialised ... *)
   A global declaration must be a Store:
       global x: Int32 = 1     (* checker: global 'x' must be declared ... *)
   A store is not a value, parameter, field, or union alternative:
       var t = s               (* checker: store 's' is not a value *)
   alloc needs a fixed type:
       s.alloc<List<Int32>>(xs) (* checker: Handle requires a fixed type *)
       s.alloc<Text>(t)         (* checker: Handle requires a fixed type *)
       s.alloc<Int32 | Nil>(1)  (* allowed: a fixed union *)
       s.alloc<Array<Int32,3>>(a) (* allowed: Array is fixed *)
   read and write need a handle:
       x.read()                (* checker: 'read' must be called on ... *)
   A string literal needs a Text or String<N> context:
       var s = "x"             (* checker: string literal needs a Text ... *)
   A literal that exceeds its fixed capacity is rejected:
       var s: String<4> = "hello"  (* checker: string literal of 5 bytes ... *)
   A non-empty list literal can infer a fixed Array<T,N> from one common element
   type; an empty or mixed literal needs an Array/union context:
       var xs = [1, 2]             (* inferred Array<Int32,2> *)
       var xs: Array<Int32, 5> = [1, 2] (* capacity 5, length 2 *)
       var xs: List<Int32> = [1]   (* checker: dynamic list literal rejected *)
       var xs: Array<Int32, 2> = [1, 2, 3] (* checker: over capacity *)
       var xs = []                 (* checker: cannot infer element type *)
   Text and String<N> do not convert implicitly:
       var a: String<8> = "x"
       var b: Text = a       (* checker: initialiser type does not match *)
       var c: String<16> = a   (* checker: initialiser type does not match *)
   Error needs all six arguments in order:
       Error("E", "d")         (* checker: Error takes header, description ... *)
   Assignment is not an expression:
       var y: Int32 = (x = 1)  (* parser: expected ')' *)
   Assignment targets a variable, not a store or function:
       s = 1                   (* checker: 's' is not an assignable variable *)
   An expression statement must be a call:
       fun f(): Int32 1 end    (* checker: expression statement must be a call *)
   Type arguments are inferred at calls, not written:
       identity<Int32>(3)      (* checker: generic function 'identity' must be called *)
   typeof needs a single non-union target:
       typeof x is Int32 | Bool    (* checker: type test requires a single ... *)
   Function bodies contain statements, not raw expressions:
       fun f(x:Int32):Int32 x end
                               (* parser: expected a statement or 'end' ... *)
   if needs then:
       if x > 0 return 1 end   (* parser: expected 'then' ... *)
   Conditions must be Bool:
       if 1 then ... end       (* checker: condition must be Bool *)
   break and continue need an enclosing while:
       break                   (* checker: 'break' outside a loop *)
   Every function must return on every path:
       fun f(x:Int32):Int32
         if x > 0 then return 1 end
       end                     (* checker: function 'f' may reach the end
                                  without returning *)
   A type cannot contain itself by value:
       type Loop = Loop | Int32 (* checker: type 'Loop' is defined recursively *)
*)
